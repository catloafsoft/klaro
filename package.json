{
  "author": "KIProtect GmbH",
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ],
  "bugs": {
    "url": "https://github.com/KIProtect/klaro/issues"
  },
  "description": "A simple but powerful consent manager.",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/preact": "^3.2.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^10.1.1",
    "classnames": "^2.5.1",
    "core-js": "^3.49.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "preact": "^10.29.2",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "webpack": "^5.107.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5",
    "webpack-merge": "^6.0.1",
    "yaml-loader": "^0.9.0"
  },
  "files": [
    "dist",
    "types",
    "src/**/*.css",
    "src/**/*.scss",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.jsx",
    "src/**/*.tsx",
    "src/**/*.yml"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "homepage": "https://klaro.kiprotect.com/",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "compliance"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/klaro.js",
  "module": "dist/klaro.js",
  "name": "klaro",
  "packageManager": "pnpm@11.6.0",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/klaro.js",
      "require": "./dist/klaro.js",
      "default": "./dist/klaro.js"
    },
    "./no-css": {
      "types": "./types/index.d.ts",
      "import": "./dist/klaro-no-css.js",
      "require": "./dist/klaro-no-css.js",
      "default": "./dist/klaro-no-css.js"
    },
    "./cm": {
      "types": "./types/consent-manager.d.ts",
      "import": "./dist/cm.js",
      "require": "./dist/cm.js",
      "default": "./dist/cm.js"
    },
    "./translations": {
      "types": "./types/translations.d.ts",
      "import": "./dist/translations.js",
      "require": "./dist/translations.js",
      "default": "./dist/translations.js"
    },
    "./dist/*": "./dist/*",
    "./klaro.css": "./dist/klaro.css",
    "./klaro.min.css": "./dist/klaro.min.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiprotect/klaro.git"
  },
  "scripts": {
    "lint": "eslint ./src --quiet",
    "lint-fix": "eslint ./src --fix",
    "lint-scss": "stylelint ./src/scss/*.scss --quiet",
    "lint-scss-fix": "stylelint ./src/scss/*.scss --fix",
    "make": "cross-env APP_ENV=production webpack --mode production --config webpack.config.js",
    "make-dev": "cross-env APP_ENV=dev webpack serve --mode development --config webpack.config.js",
    "make-watch": "cross-env APP_ENV=dev webpack --mode development --watch --config webpack.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "version": "0.7.22"
}
