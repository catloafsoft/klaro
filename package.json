{
  "author": "KIProtect GmbH",
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ],
  "bugs": {
    "url": "https://github.com/catloafsoft/klaro/issues"
  },
  "description": "A simple but powerful consent manager.",
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/preact": "^3.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "classnames": "^2.5.1",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "preact": "^11.0.0",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1",
    "yaml": "^2.9.1",
    "yaml-loader": "^0.9.0"
  },
  "files": [
    "cm.mjs",
    "dist",
    "types",
    "src/**/*.css",
    "src/**/*.scss",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.jsx",
    "src/**/*.tsx",
    "src/**/*.yml"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "homepage": "https://klaro.kiprotect.com/",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "compliance"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/klaro.js",
  "module": "dist/klaro.js",
  "name": "@catloafsoft/klaro",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@11.6.0",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/klaro.js",
      "require": "./dist/klaro.js",
      "default": "./dist/klaro.js"
    },
    "./no-css": {
      "types": "./types/index.d.ts",
      "import": "./dist/klaro-no-css.js",
      "require": "./dist/klaro-no-css.js",
      "default": "./dist/klaro-no-css.js"
    },
    "./cm": {
      "types": "./types/consent-manager.d.ts",
      "import": "./cm.mjs",
      "require": "./dist/cm.js",
      "default": "./dist/cm.js"
    },
    "./translations": {
      "types": "./types/translations.d.ts",
      "import": "./dist/translations.js",
      "require": "./dist/translations.js",
      "default": "./dist/translations.js"
    },
    "./dist/*": "./dist/*",
    "./klaro.css": "./dist/klaro.css",
    "./klaro.min.css": "./dist/klaro.min.css",
    "./package.json": "./package.json",
    "./dist/klaro": "./dist/klaro.js",
    "./dist/klaro-no-css": "./dist/klaro-no-css.js",
    "./dist/klaro-no-translations": "./dist/klaro-no-translations.js",
    "./dist/klaro-no-translations-no-css": "./dist/klaro-no-translations-no-css.js",
    "./dist/cm": "./dist/cm.js",
    "./dist/cm-no-css": "./dist/cm-no-css.js",
    "./dist/translations": "./dist/translations.js",
    "./dist/translations-no-css": "./dist/translations-no-css.js",
    "./dist/ide": "./dist/ide.js",
    "./dist/ide-no-css": "./dist/ide-no-css.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catloafsoft/klaro.git"
  },
  "scripts": {
    "lint": "eslint ./src --quiet",
    "lint-fix": "eslint ./src --fix",
    "lint-scss": "stylelint ./src/scss/*.scss --quiet",
    "lint-scss-fix": "stylelint ./src/scss/*.scss --fix",
    "make": "cross-env APP_ENV=production webpack --mode production --config webpack.config.js",
    "make-dev": "cross-env APP_ENV=dev webpack serve --mode development --config webpack.config.js",
    "make-watch": "cross-env APP_ENV=dev webpack --mode development --watch --config webpack.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release-metadata": "node .scripts/update-release.cjs"
  },
  "version": "0.8.1",
  "engines": {
    "node": ">=24.11.0"
  }
}
